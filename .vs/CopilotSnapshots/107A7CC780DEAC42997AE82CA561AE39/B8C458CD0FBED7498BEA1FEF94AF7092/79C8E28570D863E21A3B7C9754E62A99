<Window x:Class="SemiSim.Wpf.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="SemiSim EDA - Native Process Viewer" Height="860" Width="1440"
		MinHeight="650" MinWidth="1050" Background="#202225" Foreground="#D7DDE5">
	<DockPanel>
		<ToolBar DockPanel.Dock="Top" Background="#262A2F">
			<Button Content="Reset process" Click="Reset_Click" />
			<TextBlock x:Name="StepSummary" VerticalAlignment="Center" Margin="12,0" />
		</ToolBar>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="270" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="320" />
			</Grid.ColumnDefinitions>
			<Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="12">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Cell Navigator" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
					<TreeView Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
						<TreeViewItem Header="TOP_CELL" IsExpanded="True">
							<TreeViewItem Header="NMOS_X1" IsExpanded="True">
								<TreeViewItem Header="Terminals">
									<TreeViewItem Header="GATE - IN" />
									<TreeViewItem Header="SOURCE - VSS" />
									<TreeViewItem Header="DRAIN - OUT" />
									<TreeViewItem Header="BULK - P-WELL" />
								</TreeViewItem>
								<TreeViewItem Header="Layout Layers">
									<TreeViewItem Header="ACTIVE" />
									<TreeViewItem Header="POLY_GATE" />
									<TreeViewItem Header="CONTACT" />
									<TreeViewItem Header="M1_SOURCE / M1_DRAIN" />
									<TreeViewItem Header="M2 routing" />
								</TreeViewItem>
							</TreeViewItem>
						</TreeViewItem>
					</TreeView>
				</DockPanel>
			</Border>
			<Border Grid.Column="1" Background="#090D12" Margin="1">
				<Grid>
					<Image x:Name="SceneImage" Stretch="Fill" MouseLeftButtonDown="Scene_MouseLeftButtonDown"
						   MouseLeftButtonUp="Scene_MouseLeftButtonUp" MouseMove="Scene_MouseMove"
						   MouseWheel="Scene_MouseWheel" SizeChanged="Scene_SizeChanged" />
					<StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,12" IsHitTestVisible="False">
						<TextBlock Text="NMOS_X1 transistor process view" Foreground="#E5EDF7" />
						<TextBlock x:Name="MaskSummary" Foreground="#94A3B8" />
						<TextBlock Text="Drag to rotate · Wheel to zoom" Foreground="#94A3B8" />
					</StackPanel>
				</Grid>
			</Border>
			<Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="12">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Process Flow" FontWeight="Bold" FontSize="16" />
						<TextBlock x:Name="ProcessStepTitle" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
						<StackPanel x:Name="ParameterPanel" />
						<Button Content="Apply process values" Click="Apply_Click" />
						<Button Content="Reset to substrate" Click="Reset_Click" />
						<TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8" />
						<Separator Margin="0,10" />
						<TextBlock Text="Layers" FontWeight="Bold" FontSize="15" />
						<ItemsControl x:Name="LayersList" />
						<Separator Margin="0,10" />
						<TextBlock Text="Process log" FontWeight="Bold" FontSize="15" />
						<ItemsControl x:Name="LogList" />
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>
	</DockPanel>
</Window>