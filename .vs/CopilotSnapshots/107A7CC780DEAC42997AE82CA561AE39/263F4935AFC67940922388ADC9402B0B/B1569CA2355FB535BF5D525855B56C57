<Window x:Class="SemiconductorEdu.Wpf.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:SemiconductorEdu.Wpf.Controls"
		Title="Semiconductor Process Learning Simulator" Height="900" Width="1440"
		MinHeight="720" MinWidth="1100" Background="{StaticResource WindowBrush}">
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="#0B1219" Padding="18,12">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="8,0" />
					<Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
				</StackPanel>
				<StackPanel>
					<TextBlock Text="반도체 공정 학습 시뮬레이터" FontSize="22" FontWeight="Bold" />
					<TextBlock Text="검증되지 않은 교육용 예시 모델 · 실제 제조 레시피, 장비 운전 또는 공정 보증에 사용하지 마세요." Foreground="#FBBF24" />
				</StackPanel>
			</DockPanel>
		</Border>
		<Grid Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="340" />
			</Grid.ColumnDefinitions>
			<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="공정 단계" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
						<TextBlock Text="사용 가능" Foreground="#4ADE80" FontWeight="SemiBold" />
						<ItemsControl ItemsSource="{Binding SupportedProcesses}">
							<ItemsControl.ItemTemplate>
								<DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<Separator Margin="0,12" />
						<TextBlock Text="추후 단계 (비활성)" Foreground="#94A3B8" FontWeight="SemiBold" />
						<ItemsControl ItemsSource="{Binding PlannedProcesses}">
							<ItemsControl.ItemTemplate>
								<DataTemplate><TextBlock Text="{Binding}" Foreground="#64748B" /></DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="150" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
					<StackPanel>
						<TextBlock Text="웨이퍼 단면 · 2D 교육 시각화" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="산화막 두께는 가시성을 위해 과장 표시될 수 있습니다. 기판 전체 두께는 실제 값으로 속성 패널에 표시됩니다." Foreground="#94A3B8" />
					</StackPanel>
				</Border>
				<Border Grid.Row="1" Background="#09121C" CornerRadius="8" Margin="0,0,0,10">
					<controls:CrossSectionCanvas Columns="{Binding CrossSection}" />
				</Border>
				<Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="실행 이력" FontSize="16" FontWeight="Bold" />
						<ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" Foreground="#CBD5E1" />
					</DockPanel>
				</Border>
			</Grid>

			<Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="10,0,0,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="1단계 · 웨이퍼 초기화" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="직경 (mm)" />
						<ComboBox ItemsSource="{Binding WaferDiameters}" SelectedItem="{Binding WaferDiameterMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" Padding="7,5" />
						<TextBlock Text="기판 두께 (µm)" />
						<TextBox Text="{Binding SubstrateThicknessMicrometers, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="단면 폭 (µm)" />
						<TextBox Text="{Binding DomainWidthMicrometers, UpdateSourceTrigger=PropertyChanged}" />
						<CheckBox Content="균일 초기 SiO₂ 막 사용" IsChecked="{Binding IsUniformOxideEnabled}" Foreground="#E2E8F0" Margin="0,4" />
						<TextBlock Text="초기 산화막 (nm)" />
						<TextBox Text="{Binding InitialOxideNanometers, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsUniformOxideEnabled}" />
						<Button Content="웨이퍼 초기화" Command="{Binding InitializeWaferCommand}" Background="#334155" Foreground="White" />

						<Separator Margin="0,14" />
						<TextBlock Text="산화 공정" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="방식" />
						<ComboBox ItemsSource="{Binding OxidationMethods}" SelectedItem="{Binding OxidationMethod}" Margin="0,3,0,8" Padding="7,5" />
						<TextBlock Text="온도 (°C) · 입력 700–1200, 장비 800–1100" />
						<TextBox Text="{Binding TemperatureCelsius, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="시간 (min) · 1–240" />
						<TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="압력 (Torr) · 입력 1–760, 장비 100–760" />
						<TextBox Text="{Binding PressureTorr, UpdateSourceTrigger=PropertyChanged}" />
						<Button Content="산화 실행" Command="{Binding RunOxidationCommand}" Background="#0369A1" Foreground="White" />
						<TextBlock Text="산화막 두께" FontWeight="SemiBold" />
						<TextBlock Text="{Binding OxideThickness, StringFormat={}{0} nm}" FontSize="20" Foreground="#7DD3FC" />
						<TextBlock Text="품질 목표 70 nm ±10%" Foreground="#94A3B8" />
						<TextBlock Text="{Binding QualityResult}" FontSize="16" FontWeight="Bold" />
						<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8" />
						<Separator Margin="0,14" />
						<TextBlock Text="2단계 · 포토 / 식각 / PR 제거" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="포토 감광액 두께 (nm)" />
						<TextBox Text="{Binding PhotoResistThicknessNanometers, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="개구 시작 (µm)" />
						<TextBox Text="{Binding PhotoOpenStartMicrometers, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="개구 끝 (µm)" />
						<TextBox Text="{Binding PhotoOpenEndMicrometers, UpdateSourceTrigger=PropertyChanged}" />
						<Button Content="포토 패턴 적용" Command="{Binding RunPhotolithographyCommand}" Background="#475569" Foreground="White" />
						<TextBlock Text="식각 대상" />
						<ComboBox ItemsSource="{Binding EtchMaterials}" SelectedItem="{Binding EtchTargetMaterial}" Margin="0,3,0,8" Padding="7,5" />
						<TextBlock Text="식각 깊이 (nm)" />
						<TextBox Text="{Binding EtchDepthNanometers, UpdateSourceTrigger=PropertyChanged}" />
						<Button Content="패턴 개구부 식각" Command="{Binding RunEtchCommand}" Background="#475569" Foreground="White" />
						<Button Content="감광액(PR) 제거 세정" Command="{Binding RunPhotoresistStripCommand}" Background="#475569" Foreground="White" />
						<Separator Margin="0,14" />
						<TextBlock Text="3단계 · 증착 / CMP (교육용 단순 모델)" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="증착 방식" />
						<ComboBox ItemsSource="{Binding DepositionMethods}" SelectedItem="{Binding DepositionMethod}" Margin="0,3,0,8" Padding="7,5" />
						<TextBlock Text="막 재료" />
						<ComboBox ItemsSource="{Binding DepositionMaterials}" SelectedItem="{Binding DepositionMaterial}" Margin="0,3,0,8" Padding="7,5" />
						<TextBlock Text="막 두께 (nm)" />
						<TextBox Text="{Binding DepositionThicknessNanometers, UpdateSourceTrigger=PropertyChanged}" />
						<Button Content="균일 막 증착" Command="{Binding RunDepositionCommand}" Background="#475569" Foreground="White" />
						<TextBlock Text="CMP 목표 높이 (nm)" />
						<TextBox Text="{Binding CmpTargetHeightNanometers, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="CMP 제거율 (nm/min)" />
						<TextBox Text="{Binding CmpRemovalRateNanometersPerMinute, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Text="CMP 시간 (min)" />
						<TextBox Text="{Binding CmpDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
						<Button Content="CMP 실행" Command="{Binding RunCmpCommand}" Background="#475569" Foreground="White" />
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>
	</DockPanel>
</Window>
