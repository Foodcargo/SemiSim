<Application x:Class="SemiconductorEdu.Wpf.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>
		<SolidColorBrush x:Key="WindowBrush" Color="#101820" />
		<SolidColorBrush x:Key="PanelBrush" Color="#1B2836" />
		<SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="#E2E8F0" />
			<Setter Property="Margin" Value="0,3" />
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Margin" Value="0,3,0,8" />
			<Setter Property="Padding" Value="7,5" />
			<Setter Property="MinWidth" Value="90" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="Margin" Value="0,4" />
			<Setter Property="Padding" Value="10,7" />
		</Style>
	</Application.Resources>
</Application>
